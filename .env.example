# docker compose 用の設定例。このファイルを .env にコピーして編集する。

# --- 文字起こし ---
#WHISPER_MODEL=small          # tiny / base / small / medium / large-v3
#WHISPER_DEVICE=auto          # cpu / cuda
#WHISPER_COMPUTE_TYPE=auto    # int8 (CPU向け) / float16 (GPU向け) / int8_float16 (GPUでVRAM節約)
#WHISPER_BEAM_SIZE=5          # デコードのビーム幅。大きいほど精度が上がりうるが遅くなる
#JOB_WORKERS=1
#MAX_REALTIME_SESSIONS=2
#REALTIME_PARTIAL_INTERVAL=2.0  # リアルタイムの暫定表示の間隔(秒)。0 で無効化

# --- ローカル LLM 連携(要約・議事録) ---
# OpenAI 互換 API を持つローカル LLM サーバー (Ollama / LM Studio / llama.cpp など) の
# ベース URL。未設定なら機能ごと無効(UI にも表示されない)。
# Docker からホストの Ollama を使う場合: http://host.docker.internal:11434/v1
#LLM_API_URL=http://host.docker.internal:11434/v1
#LLM_MODEL=qwen2.5:7b-instruct  # 事前に `ollama pull qwen2.5:7b-instruct` 等で取得しておく
#LLM_API_KEY=                   # 認証を要求するサーバーの場合のみ

# --- 話者分離 ---
#DIARIZATION=1               # 0 で無効化
#SPEAKER_THRESHOLD=0.4       # 上げると話者が分かれやすく、下げるとまとまりやすい

# --- 公開設定 ---
#SITE_ADDRESS=localhost       # 社内公開時はホスト名に変更 (例: transcribe.example.internal)

# --- プロキシ環境 ---
# 社内プロキシ経由でしか外に出られない場合に設定する。
# ビルド時 (npm / pip) と実行時 (Hugging Face からのモデルダウンロード) の両方で使われる。
# 文字起こし自体は完全ローカルで、モデル取得後は外部通信しない。
#HTTP_PROXY=http://proxy.example.internal:8080
#HTTPS_PROXY=http://proxy.example.internal:8080
#NO_PROXY=localhost,127.0.0.1
