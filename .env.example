# docker compose 用の設定例。このファイルを .env にコピーして編集する。

# --- 文字起こし ---
#WHISPER_MODEL=small          # tiny / base / small / medium / large-v3
#WHISPER_DEVICE=auto          # cpu / cuda
#WHISPER_COMPUTE_TYPE=auto    # int8 (CPU向け) / float16 (GPU向け)
#JOB_WORKERS=1
#MAX_REALTIME_SESSIONS=2

# --- 公開設定 ---
#SITE_ADDRESS=localhost       # 社内公開時はホスト名に変更 (例: transcribe.example.internal)

# --- プロキシ環境 ---
# 社内プロキシ経由でしか外に出られない場合に設定する。
# ビルド時 (npm / pip) と実行時 (Hugging Face からのモデルダウンロード) の両方で使われる。
# 文字起こし自体は完全ローカルで、モデル取得後は外部通信しない。
#HTTP_PROXY=http://proxy.example.internal:8080
#HTTPS_PROXY=http://proxy.example.internal:8080
#NO_PROXY=localhost,127.0.0.1
